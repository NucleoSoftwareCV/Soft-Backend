# Copia este archivo como .env para desarrollo local.
POSTGRES_DB=OonaDB
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

DB_URL=jdbc:postgresql://localhost:5432/OonaDB
DB_USERNAME=postgres
DB_PASSWORD=postgres

JWT_SECRET=dev-local-jwt-secret-change-only-for-production-1234567890
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000
APP_FIELD_ENCRYPTION_KEY=dev-local-field-encryption-key-change-in-production

# Login con Google: Client ID de OAuth (debe coincidir con el "aud" del id_token)
GOOGLE_CLIENT_ID=

# IPs de proxies confiables cuyo X-Forwarded-For se acepta (coma-separado). Vacio = ninguno confiable.
TRUSTED_PROXIES=

# SMTP para envio de emails (recuperacion de contrasena, etc.)
MAIL_HOST=smtp.tu-proveedor.com
MAIL_PORT=587
MAIL_USERNAME=tu-usuario-smtp
MAIL_PASSWORD=tu-password-smtp
MAIL_FROM=no-reply@oona.es
APP_FRONTEND_URL=http://localhost:4200

SPRING_JPA_DDL_AUTO=create
SPRING_JPA_SHOW_SQL=false
SPRING_FLYWAY_BASELINE_ON_MIGRATE=false
SPRING_PROFILES_ACTIVE=dev
